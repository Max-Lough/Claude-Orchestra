{
  "order": "c-02",
  "title": "Responsive card grid",
  "requiredStructure": [
    { "name": "grid container id=card-grid role=list", "pattern": "<div class=\"card-grid\" id=\"card-grid\" role=\"list\">" },
    { "name": "exactly 3 article.card elements", "pattern": "<article class=\"card\" id=\"card-\\d\" role=\"listitem\">", "count": 3 },
    { "name": "card-1 present with fixed h2 copy", "pattern": "<article class=\"card\" id=\"card-1\" role=\"listitem\">\\s*<h2>Starter Plan Overview</h2>" },
    { "name": "card-2 present with fixed h2 copy", "pattern": "<article class=\"card\" id=\"card-2\" role=\"listitem\">\\s*<h2>Growth Plan Overview</h2>" },
    { "name": "card-3 present with fixed h2 copy", "pattern": "<article class=\"card\" id=\"card-3\" role=\"listitem\">\\s*<h2>Scale Plan Overview</h2>" },
    { "name": "card-1 Learn-more button aria-label", "pattern": "aria-label=\"Learn more about the Starter plan\"" },
    { "name": "card-2 Learn-more button aria-label", "pattern": "aria-label=\"Learn more about the Growth plan\"" },
    { "name": "card-3 Learn-more button aria-label", "pattern": "aria-label=\"Learn more about the Scale plan\"" },
    { "name": "base layout is single-column (grid-template-columns: 1fr)", "pattern": "\\.card-grid\\s*\\{[^}]*grid-template-columns:\\s*1fr" },
    { "name": "2-column breakpoint declared (min-width: 640px)", "pattern": "@media\\s*\\(min-width:\\s*640px\\)\\s*\\{\\s*\\.card-grid\\s*\\{[^}]*grid-template-columns:\\s*repeat\\(2" },
    { "name": "3-column breakpoint declared (min-width: 1024px)", "pattern": "@media\\s*\\(min-width:\\s*1024px\\)\\s*\\{\\s*\\.card-grid\\s*\\{[^}]*grid-template-columns:\\s*repeat\\(3" }
  ],
  "contrastPairs": [
    {
      "name": "card title text on card background",
      "min": 4.5,
      "blockPattern": "\\.card\\s*\\{([\\s\\S]*?)\\}",
      "fgPattern": "color:\\s*(#[0-9a-fA-F]{6})",
      "bgPattern": "background(?:-color)?:\\s*(#[0-9a-fA-F]{6})"
    },
    {
      "name": "card body text on card background",
      "min": 4.5,
      "blockPattern": "\\.card p\\s*\\{([\\s\\S]*?)\\}",
      "fgPattern": "color:\\s*(#[0-9a-fA-F]{6})",
      "bgPattern": "background(?:-color)?:\\s*(#[0-9a-fA-F]{6})"
    }
  ]
}
