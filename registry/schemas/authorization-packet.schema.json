{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestra/authorization-packet",
  "title": "Authorization packet",
  "description": "Required for destructive T2 and all T3 actions (final-plan.md §3.5). A schema of its own because it is the artifact a human reads before signing. No model authorizes a T3 action (P13): at T3 the approver must be a named human, recorded in the ledger.",
  "type": "object",
  "required": [
    "action",
    "risk",
    "dry_run_result",
    "rollback_script",
    "rollback_restore_test_result",
    "invariant_comparison",
    "blast_radius",
    "approver",
    "approved_at"
  ],
  "properties": {
    "action": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["T2", "T3"] },
    "dry_run_result": { "type": "string", "minLength": 1 },
    "rollback_script": { "type": "string", "minLength": 1 },
    "rollback_restore_test_result": { "type": "string", "minLength": 1 },
    "invariant_comparison": {
      "type": "object",
      "required": ["pre", "post"],
      "properties": {
        "pre": { "type": "string" },
        "post": { "type": "string" }
      },
      "additionalProperties": false
    },
    "blast_radius": { "type": "string", "minLength": 1 },
    "approver": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": { "enum": ["conductor_gate", "named_human"] },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "approved_at": { "type": "string", "minLength": 1, "description": "ISO 8601" }
  },
  "allOf": [
    {
      "if": { "properties": { "risk": { "const": "T3" } } },
      "then": {
        "properties": {
          "approver": {
            "properties": { "kind": { "const": "named_human" } }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
