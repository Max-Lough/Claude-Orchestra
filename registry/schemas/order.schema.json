{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestra/order",
  "title": "Work order",
  "description": "The dispatch contract (final-plan.md §3.5). class is a routing hypothesis (Part 4 error stance): it selects casting and cost; risk tier and author family carry the review and authorization gates. class must be an active class identifier — the alias I1 resolves to I0 at intake, before an order is written.",
  "type": "object",
  "required": [
    "task_id",
    "class",
    "risk",
    "requested_casting",
    "author_family",
    "co_author_families",
    "goal",
    "acceptance_criteria",
    "review_policy",
    "integrity_nonce"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "parent_id": { "type": ["string", "null"] },
    "class": { "enum": ["O0", "A0", "A1", "N0", "N1", "N2", "I0", "M0", "E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8", "Q0", "D0", "R0", "S0", "V0", "P0"] },
    "risk": { "enum": ["T0", "T1", "T2", "T3"] },
    "requested_casting": {
      "type": "object",
      "required": ["vendor", "model", "effort"],
      "properties": {
        "vendor": { "enum": ["anthropic", "openai"] },
        "model": { "type": "string", "minLength": 1 },
        "effort": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "author_family": { "enum": ["anthropic", "openai", "human"] },
    "co_author_families": {
      "type": "array",
      "items": { "enum": ["anthropic", "openai", "human"] },
      "uniqueItems": true
    },
    "goal": { "type": "string", "minLength": 1 },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "scope_allow": { "type": "array", "items": { "type": "string" } },
    "scope_deny": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "context_packet": { "type": "string" },
    "context_shape": { "enum": ["packet", "scoped", "subsystem", "repo", "haystack"] },
    "search_surface": { "type": "string", "description": "N0 only: the declared, exhaustible surface" },
    "tool_capabilities": { "type": "array", "items": { "type": "string" }, "description": "Dispatcher-pinned; a read-only pin here is how the Conductor holds the merged Investigator to its read-only-first law" },
    "destructive_actions": { "type": "array", "items": { "type": "string" } },
    "verification_manifest": { "type": "array", "items": { "type": "string" } },
    "verification_commands": { "type": "array", "items": { "type": "string" } },
    "verification_tier": { "enum": ["full", "inert"] },
    "tool_budget": { "type": "integer", "minimum": 1 },
    "review_policy": { "enum": ["mandatory", "preferred", "none"] },
    "hazard_profile": { "type": "string" },
    "escalation_triggers": { "type": "array", "items": { "type": "string" } },
    "artifact_location": { "type": "string" },
    "integrity_nonce": { "type": "string", "minLength": 8 }
  },
  "additionalProperties": false
}
