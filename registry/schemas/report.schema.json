{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestra/report",
  "title": "Work report",
  "description": "The executor's return contract (final-plan.md §3.5, plus the final ruling's first-class RECLASSIFY status). RECLASSIFY is a normal, ledgered event: it neither counts as a REVISE nor consumes the order's escalation allowance, and it must carry the recommended class and the observed evidence.",
  "type": "object",
  "required": [
    "status",
    "summary",
    "requested_casting",
    "author_family",
    "co_author_families",
    "served_model",
    "integrity"
  ],
  "properties": {
    "status": { "enum": ["DONE", "PARTIAL", "BLOCKED", "CHECKPOINT", "UNAVAILABLE", "WAITING_FOR_REVIEW", "ESCALATE", "RECLASSIFY"] },
    "summary": { "type": "string", "minLength": 1 },
    "changes": { "type": "array", "items": { "type": "string" }, "description": "path:line entries" },
    "paths_read": { "type": "array", "items": { "type": "string" } },
    "search_manifest": { "type": "array", "items": { "type": "string" }, "description": "N0 only" },
    "commands_run": { "type": "array", "items": { "type": "string" } },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "actual_output"],
        "properties": {
          "command": { "type": "string" },
          "actual_output": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "deviations": { "type": "array", "items": { "type": "string" } },
    "residual_risks": { "type": "array", "items": { "type": "string" } },
    "scope_variance": { "type": "string" },
    "recommended_next_class": { "enum": ["O0", "A0", "A1", "N0", "N1", "N2", "I0", "M0", "E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8", "Q0", "D0", "R0", "S0", "V0", "P0"] },
    "reclassify": {
      "type": "object",
      "description": "Required when status is RECLASSIFY (error stance, final ruling 2026-08-29)",
      "required": ["recommended_class", "evidence"],
      "properties": {
        "recommended_class": { "enum": ["O0", "A0", "A1", "N0", "N1", "N2", "I0", "M0", "E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8", "Q0", "D0", "R0", "S0", "V0", "P0"] },
        "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "hop": { "type": "integer", "minimum": 1, "description": "1 is routine; 2 escalates to the Conductor as a classification defect" }
      },
      "additionalProperties": false
    },
    "tree_identity": { "type": "string" },
    "requested_casting": {
      "type": "object",
      "required": ["vendor", "model", "effort"],
      "properties": {
        "vendor": { "enum": ["anthropic", "openai"] },
        "model": { "type": "string" },
        "effort": { "type": "string" }
      },
      "additionalProperties": false
    },
    "author_family": { "enum": ["anthropic", "openai", "human"] },
    "co_author_families": {
      "type": "array",
      "items": { "enum": ["anthropic", "openai", "human"] },
      "uniqueItems": true
    },
    "served_model": { "type": "string", "minLength": 1, "description": "Where exposed; the literal UNKNOWN otherwise (P15: attest what actually served the turn)" },
    "fallback_or_classifier_signal": { "type": ["string", "null"] },
    "pool_observation": { "type": ["string", "null"] },
    "integrity": {
      "type": "object",
      "required": ["nonce_echo"],
      "properties": {
        "nonce_echo": { "type": "string", "minLength": 8 },
        "tree_audit": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "RECLASSIFY" } } },
      "then": { "required": ["reclassify"] }
    }
  ],
  "additionalProperties": false
}
